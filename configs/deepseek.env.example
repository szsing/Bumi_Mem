#!/usr/bin/env bash
# Copy to /home/legendre/data/ZhixingSun/mem0-runtime/secrets/deepseek.env
# and keep the real file outside Git.
OPENAI_API_KEY=""
OPENAI_BASE_URL="https://api.deepseek.com/v1"
DEEPSEEK_MODEL="deepseek-v4-pro"

# Bumi_Mem defaults. Chat and memory providers can be selected independently.
CHAT_PROVIDER="deepseek"
MEMORY_PROVIDER="deepseek"
# BUMI_CHAT_MODEL="deepseek-v4-pro"
# BUMI_MEMORY_MODEL="deepseek-v4-pro"
# BUMI_CHAT_BASE_URL="https://api.deepseek.com/v1"
# BUMI_MEMORY_BASE_URL="https://api.deepseek.com/v1"
MEM0_EMBED_DEVICE="cpu"
MEM0_MEMORY_MAX_TOKENS="4096"
L1_RETENTION_DAYS="0"
ALLOW_LOCAL_FALLBACK="false"

# LoCoMo benchmark defaults.
LOCOMO_MAX_WORKERS="2"
LOCOMO_RPM="120"
LOCOMO_TOP_K="200"
LOCOMO_TOP_K_CUTOFFS="200"
