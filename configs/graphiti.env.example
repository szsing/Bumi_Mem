# 本次改动（2026-10-21）：新增 BUMI_REGISTERED_ISOLATION=on 样例，提示先注册用户再读取个人长期记忆。
# Copy outside the repository; fill credentials locally. Do not reuse the old data directory.
BUMI_DATA_DIR=/data1/sunzhixing/bumi-graphiti/data
BUMI_NEO4J_DATA_DIR=/data1/sunzhixing/bumi-graphiti/neo4j
BUMI_EMBED_MODEL_PATH=/data1/sunzhixing/model/Qwen3-Embedding-0.6B
# RRF ranking needs no BGE model. Legacy BUMI_RERANKER_MODEL_PATH is ignored.
BUMI_EMBED_DEVICE=auto
BUMI_NEO4J_URI=bolt://127.0.0.1:7687
BUMI_NEO4J_USER=neo4j
BUMI_NEO4J_PASSWORD=CHANGE_THIS_NEO4J_PASSWORD
BUMI_SERVICE_API_KEY=CHANGE_TO_A_RANDOM_SERVICE_KEY_AT_LEAST_32_CHARS
BUMI_MEMORY_API_KEY=CHANGE_TO_YOUR_DEEPSEEK_KEY
BUMI_MEMORY_PROVIDER=deepseek
BUMI_MEMORY_MODEL=deepseek-flash
BUMI_MEMORY_BASE_URL=https://api.deepseek.com/v1
BUMI_AGENT_ID=bumi_robot_001
BUMI_EXTRACTION_TURNS=10
BUMI_EXTRACTION_TOKENS=8000
BUMI_COMMUNITY_EVERY=5
BUMI_GRAPH_MAX_COROUTINES=3
BUMI_MAX_MESSAGES=20
BUMI_MAX_L1_TOKENS=8000
BUMI_CARRYOVER_MESSAGES=20
BUMI_MEMORY_READ_TIMEOUT=30
BUMI_EXPLICIT_RECALL_TIMEOUT=30
BUMI_MEMORY_WARMUP_TIMEOUT=300
BUMI_HOST=127.0.0.1
# 端口有三个不同来源，验收时不要混用：
#   1. 模块默认值   src/bumi_mem/api.py  -> 8088
#   2. 本样例文件   以下这一行           -> 18099
#   3. 实际启动值   run_memory_service.sh 前 source 的私有配置（server_probe 会回显）
# 本机 8088 已被既有实例占用（Bumi_Mem/.venv ... -m bumi_mem.api，pid 沿用中），
# 实验一律不使用 8088。约定：旧系统测试实例 18088，新系统测试实例 18099。
# 启动前先确认空闲：ss -ltn | grep -E ':(18088|18099)\b'
BUMI_PORT=18099
# Absolute Python executable in the environment installed with this checkout.
# The Windows .venv shipped in this repo is NOT usable on Linux; create a
# separate Linux environment outside the checkout and point this at it.
# BUMI_PYTHON=/data1/sunzhixing/bumi-memory-ab/venvs/bumi-graphiti/bin/python

# Registered identity isolation: register users via /v2/admin/users before personal recall.
BUMI_REGISTERED_ISOLATION=on
