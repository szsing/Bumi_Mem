# Copy OUTSIDE the repository. Set credentials there; never commit real keys.
# Linux paths below are examples: replace with paths that actually exist on your server.
BUMI_HOST="127.0.0.1"
BUMI_PORT="8088"
BUMI_AGENT_ID="bumi_test_agent"
BUMI_DATA_DIR="/data1/sunzhixing/mem0-runtime/agent-test-data"
BUMI_EMBED_MODEL_PATH="/data1/sunzhixing/models/Qwen3-Embedding-0.6B"
MEM0_EMBED_DEVICE="cuda"
# If needed, select the server Python; otherwise activated environment's python is used.
# BUMI_PYTHON="/path/to/python"

# Agent team's service credential, not the upstream LLM key. Minimum 32 characters.
BUMI_SERVICE_API_KEY=""

# OUR memory summary/extraction model (Agent's answer model is NOT configured here).
BUMI_MEMORY_PROVIDER="deepseek"
BUMI_MEMORY_BASE_URL="https://api.deepseek.com/v1"
BUMI_MEMORY_MODEL="deepseek-chat"
BUMI_MEMORY_API_KEY=""
BUMI_SUMMARY_MAX_TOKENS="512"
BUMI_MEMORY_MAX_TOKENS="4096"

# Wait/degradation deadlines, NOT measured embedding/Qdrant retrieval latency.
BUMI_MEMORY_READ_TIMEOUT="0.2"
BUMI_EXPLICIT_RECALL_TIMEOUT="1.0"
# For accurate relative dates pass query_occurred_at/previous_reply_occurred_at
# with explicit UTC offsets. Without them the server's local receipt time is used.
BUMI_MEMORY_WARMUP_TIMEOUT="120"
BUMI_MAX_MESSAGES="20"
BUMI_MAX_L1_TOKENS="8000"
# Number of MESSAGES, not full dialogue rounds.
BUMI_CARRYOVER_MESSAGES="4"
BUMI_TOP_K="5"
BUMI_SEARCH_THRESHOLD="0.1"
BUMI_MEMORY_MAX_ATTEMPTS="3"
BUMI_MEMORY_RETRY_BASE_SECONDS="5"
